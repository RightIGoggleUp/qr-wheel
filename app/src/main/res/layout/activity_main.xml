<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/screenQr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan to Enter"
                    android:textColor="@color/text"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Point your camera at the code"
                    android:textColor="@color/text_dim"
                    android:textSize="17sp"
                    android:layout_marginTop="10dp" />
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:padding="24dp"
                    android:layout_marginTop="40dp">
                    <ImageView
                        android:id="@+id/imgQr"
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:contentDescription="QR code for the signup page" />
                </FrameLayout>
                <TextView
                    android:id="@+id/txtQrUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_dim"
                    android:textSize="16sp"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="24dp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/screenWheel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prize Wheel"
                    android:textColor="@color/text"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spin to pick a winner"
                    android:textColor="@color/text_dim"
                    android:textSize="17sp"
                    android:layout_marginTop="10dp" />
                <com.anotherpatkreation.qrwheel.WheelView
                    android:id="@+id/wheelView"
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:layout_marginTop="32dp" />
                <TextView
                    android:id="@+id/btnSpin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="36dp"
                    android:background="@drawable/bg_button_red"
                    android:gravity="center"
                    android:text="SPIN THE WHEEL"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
                <TextView
                    android:id="@+id/txtCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_dim"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp" />
                <TextView
                    android:id="@+id/btnRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh list"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:padding="10dp"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF22222C" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF12121A"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabQr"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/tabQrIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_qr" />
            <TextView
                android:id="@+id/tabQrLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR Code"
                android:textSize="13sp"
                android:layout_marginTop="3dp" />
            <ImageView
                android:id="@+id/tabQrDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/ic_dot"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabWheel"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/tabWheelIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_wheel" />
            <TextView
                android:id="@+id/tabWheelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prize Wheel"
                android:textSize="13sp"
                android:layout_marginTop="3dp" />
            <ImageView
                android:id="@+id/tabWheelDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/ic_dot"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
