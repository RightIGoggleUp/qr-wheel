<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/screenQr"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan to Enter"
                android:textColor="@color/text"
                android:textSize="40sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Point your camera at the code"
                android:textColor="@color/text_dim"
                android:textSize="20sp"
                android:layout_marginTop="10dp" />
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_gravity="center_horizontal"
                android:gravity="center">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:padding="26dp">
                    <ImageView
                        android:id="@+id/imgQr"
                        android:layout_width="300dp"
                        android:layout_height="300dp"
                        android:contentDescription="QR code for the signup page" />
                </FrameLayout>
            </FrameLayout>
            <TextView
                android:id="@+id/txtQrUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="19sp"
                android:layout_marginBottom="28dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/screenWheel"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prize Wheel"
                android:textColor="@color/text"
                android:textSize="40sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spin to pick a winner"
                android:textColor="@color/text_dim"
                android:textSize="20sp"
                android:layout_marginTop="10dp" />
            <com.anotherpatkreation.qrwheel.WheelView
                android:id="@+id/wheelView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp" />
            <TextView
                android:id="@+id/btnSpin"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_button_red"
                android:gravity="center"
                android:text="SPIN THE WHEEL"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
            <TextView
                android:id="@+id/txtCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="18sp"
                android:layout_marginTop="12dp" />
            <TextView
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refresh list"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:padding="8dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF22222C" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF12121A"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabQr"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/tabQrIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_qr" />
            <TextView
                android:id="@+id/tabQrLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR Code"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
            <ImageView
                android:id="@+id/tabQrDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/ic_dot"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabWheel"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/tabWheelIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_wheel" />
            <TextView
                android:id="@+id/tabWheelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prize Wheel"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
            <ImageView
                android:id="@+id/tabWheelDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/ic_dot"
                android:layout_marginTop="5dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
