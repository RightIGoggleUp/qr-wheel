<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/btnEditLink"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_edit"
            android:contentDescription="Change QR link" />
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="8dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/screenInfo"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FloorDay"
                android:textColor="@color/text"
                android:textSize="40sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="by AnotherPatKreation"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name and email - that is all it takes"
                android:textColor="@color/text_dim"
                android:textSize="15sp"
                android:layout_marginTop="10dp" />
            <ImageButton
                android:id="@+id/btnScanBadge"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_camera"
                android:contentDescription="Scan a badge" />
            <EditText
                android:id="@+id/inpName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_dark"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:hint="Full name"
                android:textColor="@color/text"
                android:textColorHint="#FF6E6E7A"
                android:textSize="19sp"
                android:singleLine="true"
                android:inputType="textPersonName|textCapWords" />
            <EditText
                android:id="@+id/inpEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_dark"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:hint="Email"
                android:textColor="@color/text"
                android:textColorHint="#FF6E6E7A"
                android:textSize="19sp"
                android:singleLine="true"
                android:inputType="textEmailAddress" />
            <LinearLayout
                android:id="@+id/optRow1"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/optRow2"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/optRow3"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/optRow4"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/btnAddEntry"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_red"
                android:gravity="center"
                android:text="ADD TO THE DRAWING"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/screenQr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <ImageView
                android:id="@+id/qrBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#B30E0E12" />
            <LinearLayout
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">
                <TextView
                    android:id="@+id/txtQrTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="FloorDay"
                    android:textColor="@color/text"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <LinearLayout
                    android:id="@+id/qrGrid"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">
                <LinearLayout
                    android:id="@+id/qrCell1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">
                    <com.anotherpatkreation.qrwheel.QrCardView
                        android:id="@+id/qrView1"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="QR code 1" />
                    <TextView
                        android:id="@+id/txtQrLabel1"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_horizontal"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="2" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/qrCell2"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">
                    <com.anotherpatkreation.qrwheel.QrCardView
                        android:id="@+id/qrView2"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="QR code 2" />
                    <TextView
                        android:id="@+id/txtQrLabel2"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_horizontal"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="2" />
                </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">
                <LinearLayout
                    android:id="@+id/qrCell3"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">
                    <com.anotherpatkreation.qrwheel.QrCardView
                        android:id="@+id/qrView3"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="QR code 3" />
                    <TextView
                        android:id="@+id/txtQrLabel3"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_horizontal"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="2" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/qrCell4"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent">
                    <com.anotherpatkreation.qrwheel.QrCardView
                        android:id="@+id/qrView4"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="QR code 4" />
                    <TextView
                        android:id="@+id/txtQrLabel4"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_horizontal"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="2" />
                </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/screenWheel"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prize Wheel"
                android:textColor="@color/text"
                android:textSize="40sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spin to pick a winner"
                android:textColor="@color/text_dim"
                android:textSize="20sp"
                android:layout_marginTop="10dp" />
            <com.anotherpatkreation.qrwheel.WheelView
                android:id="@+id/wheelView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp" />
            <TextView
                android:id="@+id/btnSpin"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_button_red"
                android:gravity="center"
                android:text="SPIN THE WHEEL"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/screenPlayers"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Players"
                android:textColor="@color/text"
                android:textSize="36sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtPlayerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="18sp"
                android:layout_marginTop="8dp" />
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="14dp">
                <LinearLayout
                    android:id="@+id/listEntries"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>
            <TextView
                android:id="@+id/btnEmailParticipants"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_red"
                android:gravity="center"
                android:text="PREPARE BCC EMAIL"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
            <TextView
                android:id="@+id/btnExport"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_dark"
                android:gravity="center"
                android:text="EXPORT PLAYER LIST"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF22222C" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF12121A"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabInfo"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/tabInfoIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_person" />
            <TextView
                android:id="@+id/tabInfoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Info"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
            <ImageView
                android:id="@+id/tabInfoDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/ic_dot"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabQr"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/tabQrIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_qr" />
            <TextView
                android:id="@+id/tabQrLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
            <ImageView
                android:id="@+id/tabQrDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/ic_dot"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabWheel"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/tabWheelIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_wheel" />
            <TextView
                android:id="@+id/tabWheelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prize Wheel"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
            <ImageView
                android:id="@+id/tabWheelDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/ic_dot"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabPlayers"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:id="@+id/tabPlayersIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_players" />
            <TextView
                android:id="@+id/tabPlayersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Players"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
            <ImageView
                android:id="@+id/tabPlayersDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/ic_dot"
                android:layout_marginTop="5dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
