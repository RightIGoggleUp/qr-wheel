<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QR link 1 (top-left code)"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/inSignupUrl"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:hint="https://your-link.com"
            android:inputType="textUri"
            android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="QR PAGE"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Page title"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/inQrTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:hint="FloorDay"
            android:singleLine="true"
            android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Background image"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fills the QR page behind the codes. A dark scrim is applied so codes stay scannable."
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/btnPickQrBg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_dark"
            android:gravity="center"
            android:text="CHOOSE BACKGROUND IMAGE"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
        <TextView
            android:id="@+id/txtQrBgStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Default dark background"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/btnClearQrBg"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:text="Remove custom image"
            android:textColor="@color/accent"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="PARTICIPANT EMAIL"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Organizer email (placed in To)"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/inOrganizerEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:hint="you@example.com"
            android:inputType="textEmailAddress"
            android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Participant email subject"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/inParticipantSubject"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:hint="Subject"
            android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Participant HTML template"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Stored only on this device. Basic HTML (bold, italic, paragraphs, links) is supported; final rendering depends on the email app you pick."
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
        <EditText
            android:id="@+id/inParticipantHtml"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="8"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:hint="HTML email template"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Winner email subject"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/inWinSubject"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:hint="Subject"
            android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Winner email body (use {name} for the winner's name)"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/inWinBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="5"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:hint="Email template"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Option button rows (extra data on the Info screen)"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Up to 4 rows, 1-4 buttons each. A row only shows on the Info screen when its switch is on. Answers land in the Excel export."
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />
        <LinearLayout
            android:id="@+id/optRowsEditor"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_button_red"
            android:gravity="center"
            android:text="SAVE"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
        <TextView
            android:id="@+id/btnNewGame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_dark"
            android:gravity="center"
            android:text="NEW GAME - CLEAR ALL PLAYERS"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The wheel spins from the names you add on the Info tab (demo names until then). The backend fields are only needed for the email-sending routes once the site is live."
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:layout_marginTop="20dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="LAST SCAN - WHAT IT READ"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
        <TextView
            android:id="@+id/txtLastScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:textIsSelectable="true" />
        <TextView
            android:id="@+id/btnPrivacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:padding="12dp"
            android:text="PRIVACY AND LEGAL"
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:letterSpacing="0.05" />
    </LinearLayout>
</ScrollView>
